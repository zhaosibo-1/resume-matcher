# ==========================================================================
#  简历 - JD 智能匹配系统 · 环境变量模板
#  用法：cp .env.example .env  然后按需修改
#  ⚠️ .env 已被 .gitignore 排除，切勿把真实 Key 提交到 GitHub
#  💡 一个都不填也能跑：解析阶段自动降级到规则引擎，全套打分链路完全真实
# ==========================================================================

# --------------------------------------------------------------------------
# 大模型配置（OpenAI 兼容协议）
# 可选 preset：deepseek | qwen | moonshot | zhipu | siliconflow | openai | custom
# 填了 LLM_API_KEY 之后，解析阶段会额外调用模型来「补漏」：
# 从口语化描述里识别规则引擎漏掉的技能与要求。
# --------------------------------------------------------------------------
LLM_PRESET=deepseek
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL 与 LLM_MODEL 留空则使用 preset 的默认值
LLM_BASE_URL=
LLM_MODEL=
# 抽取任务要的是稳定可复现，温度务必压到 0
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

# --------------------------------------------------------------------------
# 解析引擎
#   auto —— 有 Key 用模型（规则打底、模型补漏），没 Key 自动降级到规则并明确告知
#   rule —— 强制规则引擎，结果完全确定，便于对照调试
#   llm  —— 强制模型引擎，配置不全时直接报错而不是静默降级
# --------------------------------------------------------------------------
PARSER_ENGINE=auto

# --------------------------------------------------------------------------
# 服务
# --------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# 生产环境请收窄到具体域名，例如 https://your-domain.com
CORS_ORIGINS=*
# 简历文件上传大小上限（MB）
MAX_UPLOAD_MB=5
# 简历落盘目录
DATA_DIR=data

# --------------------------------------------------------------------------
# 匹配行为
# --------------------------------------------------------------------------
# 权重归一化后是否夹取到合法区间（关闭仅用于实验对照）
CLAMP_WEIGHTS=true
# 上传的简历是否写盘。测试环境建议 false，避免仓库里留下测试残留
STORE_PERSIST=true
